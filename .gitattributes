# Normalize line endings: store LF in the repository, check out LF on every OS.
# Keeps diffs clean across Windows/macOS/Linux and matches rustfmt/CI expectations.
* text=auto eol=lf

# Windows-only scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.wasm binary
*.onnx binary
*.mp3 binary
*.wav binary
*.mp4 binary
