{
  "name": "whiteboard-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "gen:bindings": "cargo run -p wb-model --features specta --bin gen-bindings",
    "build:wasm": "cargo build -p wb-player --target wasm32-unknown-unknown --profile bench-fast && wasm-bindgen --target web --out-dir src/wasm/pkg target/wasm32-unknown-unknown/bench-fast/wb_player.wasm",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "konva": "^9.3.22",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.3.2",
    "zundo": "^2.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
